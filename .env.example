# Copy to .env and fill in. All values are optional; defaults shown.

# ---------------------------------------------------------------- Tally
TALLY_HOST=http://localhost
TALLY_PORT=9000
# Name of the company to work in; empty = the company active in Tally
TALLY_COMPANY=
TALLY_TIMEOUT=120

# ---------------------------------------------------------------- LLM
# ollama | gemini | openrouter
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT=300

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------- App
LOG_LEVEL=INFO
