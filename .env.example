# Copy to .env and fill in. All values are optional; defaults shown.

# ---------------------------------------------------------------- Tally
TALLY_HOST=http://localhost
TALLY_PORT=9000
# Name of the company to work in; empty = the company active in Tally
TALLY_COMPANY=
TALLY_TIMEOUT=120

# ---------------------------------------------------------------- LLM
# ollama | gemini | openrouter
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT=300

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------- Sales vouchers
# See docs/sales-rules.md. Ledger names must exist in Tally.
SALES_VOUCHER_TYPE=Sales
SALES_LEDGER=Sales
# Sales ledger for IGST (out-of-state) sales; empty = SALES_LEDGER
SALES_INTERSTATE_LEDGER=
# Empty = the single ledger whose name contains "round"
ROUND_OFF_LEDGER=
# GST ledgers; empty = the single ledger with that GST duty head
CGST_LEDGER=
SGST_LEDGER=
IGST_LEDGER=
# Voucher number prefix, e.g. ABC for ABC/26-27/0001; empty = derived from existing vouchers
SALES_NUMBER_PREFIX=
GODOWN=Main Location
BATCH=Primary Batch

# ---------------------------------------------------------------- Purchase invoices
# Full path of the folder where supplier invoice PDFs are saved (any location).
# The mapping file pepsico_mapping.csv is kept in the same folder.
PURCHASE_INVOICE_DIR=
PURCHASE_VOUCHER_TYPE=Purchase
PURCHASE_LEDGER=Purchase
# How often the watcher looks for new PDFs
PURCHASE_WATCH_SECONDS=5

# ---------------------------------------------------------------- App
LOG_LEVEL=INFO
# Audit log of every conversation and posting (contains customer data; keep local)
AUDIT_DB_PATH=data/audit.db
